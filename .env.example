# Copy to .env and replace every placeholder locally. Never commit .env or production secrets.
POSTGRES_DB=paynexus
POSTGRES_USER=paynexus
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379

# ASP.NET Core API configuration (loaded by scripts/load-env.ps1).
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=paynexus;Username=paynexus;Password=
Authentication__Authority=
Authentication__Audience=paynexus-api
Authentication__TenantClaim=tenant_id
Frontend__Origin=http://localhost:3000
AI__ServiceUrl=http://localhost:8000
AI__ServiceKey=

# Single-tenant PayPal sandbox only. The tenant ID must match the trusted OIDC tenant_id claim.
PayPal__ClientId=
PayPal__ClientSecret=
PayPal__SandboxTenantId=

# Databricks Unity Gateway. Store the token separately with scripts/set-databricks-token.ps1.
DATABRICKS_HOST=https://dbc-a035efd2-49c6.cloud.databricks.com
DATABRICKS_MODEL=system.ai.gpt-oss-120b
AI_SERVICE_KEY=
DEMO_AGENT_ENABLED=true

# Server-side Next.js proxy settings. Keep AI_SERVICE_KEY out of NEXT_PUBLIC_* variables.
AI_SERVICE_URL=http://localhost:8000

# Next.js browser OIDC client. Register as a public Authorization Code + PKCE client.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_OIDC_AUTHORITY=
NEXT_PUBLIC_OIDC_CLIENT_ID=
NEXT_PUBLIC_OIDC_API_SCOPE=
